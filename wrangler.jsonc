
{
  "$schema": "https://www.schemastore.org/wrangler.json",

  // =========================================
  // CINEVAULT WORKER CONFIGURATION
  // =========================================

  "name": "cinevault",

  "main": "src/index.js",

  "compatibility_date": "2026-11-23",

  // =========================================
  // OBSERVABILITY LOGS
  // =========================================

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // =========================================
  // CLOUDFLARE STATIC ASSETS
  // =========================================

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  // =========================================
  // CLOUDFLARE D1 DATABASE
  // =========================================

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cinevault-db",
      "database_id": "ae4762a3-c175-4b5a-98c8-5ca5dc3e3dd7"
    }
  ]
}
