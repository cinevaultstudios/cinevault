
{
  "$schema": "https://www.schemastore.org/wrangler.json",
  "name": "cinevault-website",
  "main": "src/index.js",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cinevault-db",
      "database_id": "ae4762a3-c175-4b5a-98c8-5ca5dc3e3dd7"
    }
  ]
}
